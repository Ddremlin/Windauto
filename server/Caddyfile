{$DOMAIN} {
	encode gzip
	header {
		# только HTTPS, год; браузер не пойдёт на сервер по HTTP даже по старой ссылке
		Strict-Transport-Security "max-age=31536000"
		# файлы отдаются строго с заявленным типом — фото не станет страницей
		X-Content-Type-Options nosniff
		# страницы нельзя встроить в чужой сайт (кликджекинг)
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
		-Via
	}

	# сервер синхронизации, ссылки из писем, юридические тексты, отзывы клиентов (/r/…)
	@api path /api/* /auth/* /legal/* /r/*
	handle @api {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	# веб-версия приложения из папки web/
	handle {
		# скрипты — только свои файлы: даже если в данные попадёт <script>, браузер его не выполнит.
		# wasm-unsafe-eval и blob: — распознавание номера на телефоне (Tesseract); https: — свой сервер синхронизации
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' https:; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		header Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		root * /srv/web
		# страница и service worker — всегда свежие, иначе обновление приезжает не сразу
		@fresh path / /index.html /sw.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		# файлы сборки с хешем в имени не меняются
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
